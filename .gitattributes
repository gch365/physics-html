# 统一换行符，避免 Windows / Linux 之间出现整文件 diff
* text=auto

*.rs    text eol=lf
*.py    text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.js    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf
*.bat   text eol=crlf

*.png   binary
*.jpg   binary
*.exe   binary
*.lock  text eol=lf
